{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jacob101519/auto-route-for-codex/blob/main/skills/auto-route-for-codex/schemas/router-output.schema.json",
  "title": "Capability-Gated Codex Router Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "decision", "current", "recommended", "tool_overrides", "evidence", "route_authorization", "effective_task_kind", "reason_codes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["fit", "mismatch", "unknown"]},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "benefit", "transfer", "source_disposition", "evidence_status", "reason_code"],
      "properties": {
        "action": {"enum": ["stay", "reroute"]},
        "benefit": {"enum": ["none", "quality", "parallelism", "efficiency"]},
        "transfer": {"enum": ["none", "fork"]},
        "source_disposition": {"enum": ["keep", "archive_after_continuation_ready"]},
        "evidence_status": {"enum": ["verified", "stale", "unknown", "uncertain"]},
        "reason_code": {
          "enum": [
            "evidence_does_not_authorize_transfer",
            "current_setting_is_sufficient",
            "host_capability_gate_not_satisfied",
            "delegation_not_authorized",
            "independent_workstreams_benefit_from_parallelism",
            "current_setting_is_materially_underpowered",
            "small_underpower_gap_does_not_justify_routing_overhead",
            "one_off_savings_do_not_repay_routing_overhead",
            "history_copy_cost_cancels_efficiency_gain",
            "efficiency_recommendation_requires_manual_choice",
            "no_positive_net_value_for_new_thread"
          ]
        }
      },
      "oneOf": [
        {"properties": {"action": {"const": "stay"}, "benefit": {"const": "none"}, "transfer": {"const": "none"}, "source_disposition": {"const": "keep"}}},
        {"properties": {"action": {"const": "stay"}, "benefit": {"const": "efficiency"}, "transfer": {"const": "none"}, "source_disposition": {"const": "keep"}}},
        {"properties": {"action": {"const": "reroute"}, "benefit": {"const": "quality"}, "transfer": {"const": "fork"}, "source_disposition": {"const": "archive_after_continuation_ready"}}},
        {"properties": {"action": {"const": "reroute"}, "benefit": {"const": "parallelism"}, "transfer": {"const": "fork"}, "source_disposition": {"const": "archive_after_continuation_ready"}}}
      ]
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "model_role", "effort", "topology", "evidence_status"],
      "properties": {
        "model": {"type": "string", "pattern": "^(unknown|[A-Za-z0-9][A-Za-z0-9._+-]{0,127})$"},
        "model_role": {"enum": ["unknown", "throughput", "balanced", "deep"]},
        "effort": {"enum": ["unknown", "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]},
        "topology": {"enum": ["not_observed", "parallel"]},
        "evidence_status": {"enum": ["verified", "stale", "unknown", "uncertain"]}
      }
    },
    "recommended": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_role", "model", "effort", "thinking", "topology", "resolution"],
      "properties": {
        "model_role": {"enum": ["throughput", "balanced", "deep"]},
        "model": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"},
        "effort": {"type": ["string", "null"], "enum": [null, "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]},
        "thinking": {"type": ["string", "null"], "enum": [null, "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]},
        "topology": {"enum": ["single", "single_deep", "parallel"]},
        "resolution": {"enum": ["resolved", "unresolved"]}
      }
    },
    "tool_overrides": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "thinking"],
          "properties": {
            "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"},
            "thinking": {"enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]}
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_status", "current", "catalog", "host", "continuation_capable"],
      "properties": {
        "aggregate_status": {"enum": ["verified", "stale", "unknown", "uncertain"]},
        "current": {"$ref": "#/$defs/evidenceItem"},
        "catalog": {"$ref": "#/$defs/evidenceItem"},
        "host": {"$ref": "#/$defs/evidenceItem"},
        "continuation_capable": {"type": "boolean"}
      }
    },
    "route_authorization": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effective_task_kind": {"enum": ["simple_answer", "local_edit", "implementation", "architecture", "migration", "deep_research", "final_decision", "batch"]},
    "reason_codes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_:]+$"}, "minItems": 1, "uniqueItems": true}
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provenance"],
      "properties": {
        "status": {"enum": ["verified", "stale", "unknown", "uncertain"]},
        "provenance": {"enum": ["host_setting_receipt", "session_turn_context_receipt", "integrity_receipt", "tool_schema_receipt", "unverified"]}
      }
    }
  }
}
